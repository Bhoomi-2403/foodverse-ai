GROQ_API_KEY=your_groq_api_key_here
# Verified vision-capable model on Groq (see console.groq.com/docs/vision). Fallbacks are tried if it is retired.
GROQ_VISION_MODEL=qwen/qwen3.8-27b
GROQ_FALLBACK_MODELS=meta-llama/llama-4-scout-17b-16e-instruct,qwen/qwen3.6-27b
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
MAX_UPLOAD_MB=10
MAX_VIDEO_MB=60
MAX_VIDEO_FRAMES=6
LLM_TIMEOUT_SECONDS=60
